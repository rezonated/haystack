<Project Sdk="Microsoft.NET.Sdk">
  <!-- Gauntlet test nodes for the Haystack project. UAT compiles this when it runs with -ScriptsForProject=Haystack.uproject. -->

  <!-- EngineDir follows the engine the .uproject is associated with: UAT passes it as a global property, and
       generating project files writes it into the .props next to this file for IDE builds. -->
  <Import Project="$(MSBuildProjectFullPath).props" Condition="'$(EngineDir)' == '' And Exists('$(MSBuildProjectFullPath).props')" />
  <Import Project="$(EngineDir)\Source\Programs\Shared\UnrealEngine.csproj.props" />

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Haystack.Automation</RootNamespace>
    <AssemblyName>Haystack.Automation</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <OutputPath>..\..\Binaries\DotNET\AutomationScripts\Haystack</OutputPath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Prebuilt engine assemblies, never rebuilt from here. -->
  <ItemGroup>
    <Reference Include="AutomationTool">
      <HintPath>$(EngineDir)\Binaries\DotNET\AutomationTool\AutomationTool.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AutomationUtils.Automation">
      <HintPath>$(EngineDir)\Binaries\DotNET\AutomationTool\AutomationUtils\net10.0\AutomationUtils.Automation.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Gauntlet.Automation">
      <HintPath>$(EngineDir)\Binaries\DotNET\AutomationTool\AutomationScripts\Gauntlet\net10.0\Gauntlet.Automation.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="EpicGames.Core">
      <HintPath>$(EngineDir)\Binaries\DotNET\AutomationTool\EpicGames.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnrealBuildTool">
      <HintPath>$(EngineDir)\Binaries\DotNET\AutomationTool\UnrealBuildTool.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Gauntlet.Log overloads take an EventId from here. -->
    <Reference Include="Microsoft.Extensions.Logging.Abstractions">
      <HintPath>$(EngineDir)\Binaries\DotNET\AutomationTool\Microsoft.Extensions.Logging.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
